{
  // Kestrel menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.capture.screenshot belongs
  // under trigger.capture.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here.
  // Optional fields:
  //   aliases        alternate `kestrel menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  // Root Menu
  // Live ISO only: install Kestrel from the bundled offline repo.
  "live-install": {"icon":"","label":"Install Kestrel","when":"[[ -e /run/archiso ]]","action":"kestrel-launch-floating-terminal-with-presentation 'sudo kestrel-install'"},
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "about": {"icon":"","label":"About","action":"kestrel-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"kestrel-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"kestrel-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! kestrel-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"kestrel-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"kestrel-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"kestrel-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"kestrel-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"kestrel-menu-keybindings"},
  "learn.kestrel": {"icon":"","label":"Kestrel","action":"kestrel-launch-webapp 'https://github.com/kestrel-distro/kestrel/tree/master/manual'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"kestrel-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"kestrel-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"kestrel-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"kestrel-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"kestrel-menu-tmux-keybindings"},
  "learn.community": {"icon":"󰙯","label":"Community","action":"kestrel-launch-discord-community"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"kestrel-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"kestrel-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"kestrel-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"kestrel-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"kestrel-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"kestrel-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"kestrel-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"kestrel-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"kestrel-hw-webcam","action":"kestrel-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"kestrel-transcode"},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"kestrel-hw-laptop","action":"kestrel-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"kestrel-hw-laptop","action":"kestrel-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"kestrel-hw-hybrid-gpu","action":"kestrel-launch-floating-terminal-with-presentation kestrel-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"kestrel-hw-touchpad","action":"kestrel-toggle-touchpad"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"kestrel-hw-touchscreen","action":"kestrel-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"kestrel-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"kestrel-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"kestrel-reminder clear"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"kestrel-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"kestrel-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"kestrel-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"kestrel-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"kestrel-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"kestrel-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"kestrel-hw-laptop","action":"kestrel-shell kestrel.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"kestrel-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"kestrel-hyprland-window-gaps-toggle"},
  "trigger.toggle.animations": {"icon":"󰕟","label":"Animations","action":"kestrel-toggle-animations"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"kestrel-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"kestrel-shell shell summon kestrel.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"kestrel-shell shell summon kestrel.disk-speedtest"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"kestrel-shell shell summon kestrel.image-picker '{\"source\":\"themes\"}'"},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(kestrel-theme-bg-switcher); [[ -n $background ]] && kestrel-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(kestrel-plymouth-switcher); if [[ $unlock == default ]]; then kestrel-launch-floating-terminal-with-presentation kestrel-plymouth-reset; elif [[ -n $unlock ]]; then kestrel-launch-floating-terminal-with-presentation \"kestrel-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"kestrel-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"kestrel-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"kestrel-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"kestrel-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"kestrel-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"kestrel-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"kestrel-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"kestrel-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"kestrel-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"kestrel-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"kestrel-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"kestrel-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"kestrel-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"kestrel-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"kestrel-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(kestrel-dns)\" == \"DHCP\" ]]","action":"kestrel-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(kestrel-dns)\" == \"Cloudflare\" ]]","action":"kestrel-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(kestrel-dns)\" == \"Google\" ]]","action":"kestrel-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(kestrel-dns)\" == \"Custom\" ]]","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(kestrel-network-status) == wifi* ]]","action":"kestrel-shell shell summon kestrel.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","checked":"[[ \"$(kestrel-default-browser)\" == \"chromium\" ]]","action":"kestrel-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","checked":"[[ \"$(kestrel-default-browser)\" == \"chrome\" ]]","action":"kestrel-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","checked":"[[ \"$(kestrel-default-browser)\" == \"brave\" ]]","action":"kestrel-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","checked":"[[ \"$(kestrel-default-browser)\" == \"brave-origin\" ]]","action":"kestrel-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","checked":"[[ \"$(kestrel-default-browser)\" == \"edge\" ]]","action":"kestrel-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","checked":"[[ \"$(kestrel-default-browser)\" == \"firefox\" ]]","action":"kestrel-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","checked":"[[ \"$(kestrel-default-browser)\" == \"zen\" ]]","action":"kestrel-default-browser zen"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","checked":"[[ \"$(kestrel-default-editor)\" == \"nvim\" ]]","action":"kestrel-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","checked":"[[ \"$(kestrel-default-editor)\" == \"code\" ]]","action":"kestrel-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","iconFont":"kestrel","label":"Cursor","checked":"[[ \"$(kestrel-default-editor)\" == \"cursor\" ]]","action":"kestrel-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","checked":"[[ \"$(kestrel-default-editor)\" == \"zeditor\" ]]","action":"kestrel-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","checked":"[[ \"$(kestrel-default-editor)\" == \"subl\" ]]","action":"kestrel-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","checked":"[[ \"$(kestrel-default-editor)\" == \"helix\" ]]","action":"kestrel-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","checked":"[[ \"$(kestrel-default-editor)\" == \"vim\" ]]","action":"kestrel-default-editor vim"},
  "setup.default.editor.emacs": {"icon":" ","label":"Emacs","checked":"[[ \"$(kestrel-default-editor)\" == \"emacs\" ]]","action":"kestrel-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"kestrel-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"kestrel-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"kestrel-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/kestrel/plugins/*/manifest.json\"","action":"kestrel-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"kestrel-hw-fingerprint","action":"kestrel-launch-floating-terminal-with-presentation kestrel-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"kestrel-launch-floating-terminal-with-presentation kestrel-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"kestrel-launch-floating-terminal-with-presentation kestrel-setup-security-sshd"},
  "setup.security.ssh-agent": {"icon":"󰣀","label":"SSH Agent","when":"! systemctl --user -q is-enabled gcr-ssh-agent.socket","action":"kestrel-launch-floating-terminal-with-presentation kestrel-setup-security-ssh-agent"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"kestrel-sudo-docker --configured","action":"kestrel-launch-floating-terminal-with-presentation kestrel-setup-security-sudoless-docker"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"kestrel-launch-floating-terminal-with-presentation kestrel-sudo-passwordless"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"kestrel-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"kestrel-launch-config-editor ~/.config/hypr/hyprsunset.conf && kestrel-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"kestrel-launch-config-editor ~/.XCompose && kestrel-restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","action":"kestrel-launch-floating-terminal-with-presentation kestrel-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Reset Computer","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"kestrel-launch-floating-terminal-with-presentation kestrel-system-factory-reset"},

  // Install

  // Remove
  "remove.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.kestrel.terminal kestrel-pkg-remove"},
  "remove.service": {"icon":"","label":"Services","title":"Remove"},
  "remove.development": {"icon":"󰵮","label":"Development","title":"Remove"},
  "remove.theme": {"icon":"󰸌","label":"Theme","action":"kestrel-theme-remove"},
  "remove.gaming": {"icon":"","label":"Gaming","title":"Remove"},
  "remove.browser": {"icon":"","label":"Browser","title":"Remove"},
  "remove.webapp": {"icon":"","label":"Web App","when":"grep -qE '^Exec=.*(kestrel-launch-webapp|kestrel-webapp-handler)' $HOME/.local/share/applications/*.desktop","action":"kestrel-webapp-remove"},
  "remove.tui": {"icon":"","label":"TUI","when":"grep -qE '^Exec=.*(\\$TERMINAL|xdg-terminal-exec).*-e' $HOME/.local/share/applications/*.desktop","action":"kestrel-tui-remove"},
  "remove.windows": {"icon":"󰍲","label":"Windows","when":"[[ -f $HOME/.local/share/applications/windows-vm.desktop ]]","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-windows-vm remove'"},
  "remove.preinstalls": {"icon":"󰏓","label":"Preinstalls","when":"[[ ! -f $HOME/.local/state/kestrel/preinstalls-removed ]]","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-preinstalls"},
  "remove.security": {"icon":"","label":"Security","title":"Remove"},
  "remove.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"kestrel-pkg-present fprintd","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-security-fingerprint"},
  "remove.security.fido2": {"icon":"","label":"Fido2","when":"kestrel-pkg-present pam-u2f","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-security-fido2"},
  "remove.security.sshd": {"icon":"󰣀","label":"SSHD","when":"systemctl is-enabled --quiet sshd","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-security-sshd"},
  "remove.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"! kestrel-sudo-docker --configured","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-security-sudoless-docker"},
  "remove.browser.chrome": {"icon":"","label":"Chrome","when":"kestrel-pkg-present google-chrome","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-remove-browser chrome'"},
  "remove.browser.edge": {"icon":"󰇩","label":"Edge","when":"kestrel-pkg-present microsoft-edge-stable-bin","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-remove-browser edge'"},
  "remove.browser.brave": {"icon":"","label":"Brave","when":"kestrel-pkg-present brave-bin","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-remove-browser brave'"},
  "remove.browser.brave-origin": {"icon":"","label":"Brave Origin","when":"kestrel-pkg-present brave-origin-bin","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-remove-browser brave-origin'"},
  "remove.browser.firefox": {"icon":"","label":"Firefox","when":"kestrel-pkg-present firefox","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-remove-browser firefox'"},
  "remove.browser.zen": {"icon":"","label":"Zen","when":"kestrel-pkg-present zen-browser-bin","action":"kestrel-launch-floating-terminal-with-presentation 'kestrel-remove-browser zen'"},
  "remove.service.dropbox": {"icon":"","label":"Dropbox","when":"kestrel-pkg-present dropbox","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-service-dropbox"},
  "remove.service.tailscale": {"icon":"","label":"Tailscale","when":"kestrel-pkg-present tailscale","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-service-tailscale"},
  "remove.service.microsoft": {"icon":"󰍲","label":"Microsoft","when":"[[ -f \"$HOME/.local/share/applications/Microsoft Outlook.desktop\" || -f \"$HOME/.local/share/applications/Microsoft Word.desktop\" || -f \"$HOME/.local/share/applications/Microsoft Excel.desktop\" || -f \"$HOME/.local/share/applications/Microsoft PowerPoint.desktop\" || -f \"$HOME/.local/share/applications/Microsoft Teams.desktop\" || -f \"$HOME/.local/share/applications/Microsoft OneDrive.desktop\" ]]","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-service-microsoft"},
  "remove.service.ssh-agent": {"icon":"󰣀","label":"SSH Agent","when":"systemctl --user -q is-enabled gcr-ssh-agent.socket","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-service-ssh-agent"},
  "remove.gaming.steam": {"icon":"","label":"Steam","when":"kestrel-pkg-present steam","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-gaming-steam"},
  "remove.gaming.retroarch": {"icon":"","label":"RetroArch","when":"kestrel-pkg-present retroarch","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-gaming-retroarch"},
  "remove.gaming.minecraft": {"icon":"󰍳","label":"Minecraft","when":"kestrel-pkg-present minecraft-launcher","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-gaming-minecraft"},
  "remove.gaming.geforce-now": {"icon":"󰢹","label":"NVIDIA GeForce NOW","when":"flatpak info com.nvidia.geforcenow","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-gaming-geforce-now"},
  "remove.gaming.xbox-cloud": {"icon":"","label":"Xbox Cloud Gaming","when":"[[ -f \"$HOME/.local/share/applications/Xbox Cloud Gaming.desktop\" ]]","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-gaming-xbox-cloud"},
  "remove.gaming.xbox-controllers": {"icon":"󰖺","label":"Xbox Controllers (󰂯)","when":"kestrel-pkg-present xpadneo-dkms","action":"kestrel-launch-floating-terminal-with-presentation kestrel-remove-gaming-xbox-controllers"},
