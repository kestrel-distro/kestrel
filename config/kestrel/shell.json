{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "kestrel.clock",
    "layout": {
      "left": [
        {
          "id": "kestrel.menu"
        },
        {
          "id": "kestrel.workspaces"
        }
      ],
      "center": [
        {
          "id": "kestrel.indicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "kestrel.clock",
          "format": "dd/MM/yyyy dddd HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "kestrel.keyboard-layout"
        },
        {
          "id": "kestrel.weather"
        }
      ],
      "right": [
        {
          "id": "kestrel.tray"
        },
        {
          "id": "kestrel.bluetooth"
        },
        {
          "id": "eclipse.mpris"
        },
        {
          "id": "kestrel.agents"
        },
        {
          "id": "kestrel.network"
        },
        {
          "id": "kestrel.audio"
        },
        {
          "id": "eclipse.cpu"
        },
        {
          "id": "kestrel.monitor"
        },
        {
          "id": "kestrel.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "eclipse.pomodoro"
    }
  ]
}
