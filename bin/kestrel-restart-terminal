#!/bin/bash

# kestrel:summary=Reload supported terminal emulators after config changes

# foot has no config reload, and killing the shared server would close every
# terminal (including the shell running this). Ask the user to restart it.
if pgrep -f 'foot --server' >/dev/null; then
  kestrel-notification-send -g  "Restart Foot to apply the new configuration"
fi
